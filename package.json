{
  "name": "football-api",
  "private": true,
  "version": "0.1.0",
  "description": "Provider-agnostic football data platform on Cloudflare Workers",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @football-api/worker dev",
    "deploy": "pnpm --filter @football-api/worker deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.20250317.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
