# Copy to .env on the VPS (never commit .env).
API_SPORTS_KEY=
ADMIN_TOKEN=
ACCESS_GUARD=
ALLOWED_CF_WORKERS=verfutbollibre.net
ALLOWED_SITE_HOSTS=verfutbollibre.net
PUBLIC_BASE_URL=http://127.0.0.1:8787
LOG_LEVEL=info
# Set to 1 on dual-run staging so Hetzner does not cron-warm (avoids duplicate API-Sports usage).
DISABLE_CRON=1
